# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
# The environment definitions are the one place tfvars are committed: no secrets, no account ids.
!terraform/envs/*/terraform.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# The provider lock file IS committed so every run uses the same provider builds.
!.terraform.lock.hcl

# Build output: the Lambda bundle from scripts/build_bundle.py
.build/
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/

# Planning notes (kept local)
as-a-senior-cloud-proud-meerkat.md

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
# Modules are tested standalone in CI; only the environments pin provider hashes.
terraform/modules/**/.terraform.lock.hcl
