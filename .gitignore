# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# The provider lock file IS committed so every run uses the same provider builds.
!.terraform.lock.hcl

# Build output (Lambda bundles are produced by terraform archive_file)
.build/
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
